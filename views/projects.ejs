<%- include("partials/header") %>

<section class="page-hero">
  <span class="hero-label">ENGINEERING OPPORTUNITIES</span>
  <h1>Discover Student Projects</h1>
  <p>
    Explore activities, practical experiences and community initiatives
    where engineering students can apply their skills and make a difference.
  </p>
</section>

<section class="content-section">
  <div class="section-heading">
    <h2>Explore Projects</h2>
    <p>
      Develop your skills, work with others and contribute
      to meaningful projects.
    </p>
  </div>

  <div class="card-grid">

    <!-- Environmental Projects -->
    <article class="content-card">
      <img
        src="/images/environment.jpg"
        alt="Students participating in environmental activities"
        class="project-image"
      >
      <h3>Environmental Projects</h3>
      <p>
        Participate in environmental activities, conservation
        campaigns and community clean-up initiatives.
      </p>
      <span class="card-tag">Environmental</span>
    </article>

    <!-- Academic Mentorship -->
    <article class="content-card">
      <img
        src="/images/education.jpg"
        alt="Students learning and sharing academic knowledge"
        class="project-image"
      >
      <h3>Academic Mentorship</h3>
      <p>
        Support fellow students through tutoring,
        knowledge sharing and academic mentorship.
      </p>
      <span class="card-tag">Educational</span>
    </article>

    <!-- Community Outreach -->
    <article class="content-card">
      <img
        src="/images/community_outreach.jfif"
        alt="Students participating in community outreach"
        class="project-image"
      >
      <h3>Community Outreach</h3>
      <p>
        Participate in outreach programmes that support
        communities and encourage positive change.
      </p>
      <span class="card-tag">Community Service</span>
    </article>

    <!-- Health and Wellness -->
    <article class="content-card">
      <img
        src="/images/health.jfif"
        alt="Students promoting health and wellness"
        class="project-image"
      >
      <h3>Health and Wellness Campaigns</h3>
      <p>
        Promote healthy lifestyles, student wellbeing
        and awareness through organised activities.
      </p>
      <span class="card-tag">Health and Wellness</span>
    </article>

  </div>
</section>

<%- include("partials/footer") %>