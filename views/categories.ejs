<%- include("partials/header") %>

<section class="page-hero" aria-labelledby="categories-heading">
  <span class="hero-label">EXPLORE OPPORTUNITIES</span>
  <h1 id="categories-heading">Explore Categories</h1>
  <p>
    Discover different areas of service and find opportunities
    to contribute your skills and make a positive difference.
  </p>
</section>

<section class="content-section" aria-label="Available categories">

  <div class="category-grid">

    <!-- Environmental -->
    <article class="category-card">
      <img
        src="/images/environment.jpg"
        alt="Environmental conservation activities"
        class="category-image"
      >
      <h2>Environmental</h2>
      <p>
        Protect nature, plant trees, promote conservation
        and support cleaner communities.
      </p>
    </article>

    <!-- Educational -->
    <article class="category-card">
      <img
        src="/images/education.jpg"
        alt="Students participating in educational activities"
        class="category-image"
      >
      <h2>Educational</h2>
      <p>
        Support education through tutoring, mentoring
        and learning activities.
      </p>
    </article>

    <!-- Community Service -->
    <article class="category-card">
      <img
        src="/images/community_outreach.jpg"
        alt="Community service and outreach activities"
        class="category-image"
      >
      <h2>Community Service</h2>
      <p>
        Help families, support local initiatives
        and strengthen communities.
      </p>
    </article>

    <!-- Health and Wellness -->
    <article class="category-card">
      <img
        src="/images/health.jpg"
        alt="Health and wellness activities"
        class="category-image"
      >
      <h2>Health and Wellness</h2>
      <p>
        Promote healthy living and support community
        wellness activities.
      </p>
    </article>

  </div>

</section>

<%- include("partials/footer") %>