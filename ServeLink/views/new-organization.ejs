<%- include("partials/header") %>

<section class="page-hero">
  <span class="hero-label">GROW OUR ENGINEERING COMMUNITY</span>
  <h1>Add an Organization</h1>
  <p>Share your organization with the KYUES community.</p>
</section>

<section class="content-section">
  <div class="question-box organization-form">
    <h2>Organization details</h2>
    <p>Complete the fields below. All fields are required.</p>

    <form action="/new-organization" method="POST">
      <div class="form-group">
        <label for="name">Organization name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="150"
          placeholder="Enter organization name"
          autocomplete="organization"
        >
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="description"
          required
          maxlength="500"
          rows="6"
          placeholder="Describe the organization (maximum 500 characters)"
        ></textarea>
      </div>

      <div class="form-group">
        <label for="contactEmail">Contact email</label>
        <input
          type="email"
          id="contactEmail"
          name="contactEmail"
          required
          placeholder="name@example.com"
          autocomplete="email"
        >
      </div>

      <button type="submit" class="primary-button">Save Organization</button>
    </form>
  </div>
</section>

<%- include("partials/footer") %>
