<%- include('partials/header') %>

<section class="page-hero" aria-labelledby="organization-heading">
  <span class="hero-label">OUR ENGINEERING COMMUNITY</span>
  <h1 id="organization-heading"><%= organization.name %></h1>
  <p><%= organization.description %></p>
</section>

<section class="content-section" aria-labelledby="organization-projects-heading">
  <div class="section-heading">
    <h2 id="organization-projects-heading">Projects from this organization</h2>
    <p>Explore the service opportunities supported by <%= organization.name %>.</p>
  </div>

  <% if (projects.length > 0) { %>
    <div class="card-grid">
      <% projects.forEach((project) => { %>
        <article class="content-card">
          <% if (project.image_filename) { %>
            <img class="project-image" src="/images/<%= project.image_filename %>" alt="">
          <% } %>
          <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
          <p><%= project.description %></p>
          <p>Date: <%= new Date(project.date).toLocaleDateString('en-UG', { dateStyle: 'long' }) %></p>
          <p>Location: <%= project.location %></p>
          <a class="card-tag" href="/category/<%= project.category_id %>">Explore category</a>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <p>No service projects are currently listed for this organization.</p>
  <% } %>

  <p><a href="/organizations">← All organizations</a></p>
</section>

<%- include('partials/footer') %>
